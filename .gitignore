/target
.DS_Store

# フロントエンド
node_modules/
/dist/
# Tauri が生成するスキーマ・権限定義
/src-tauri/gen/

# --- 実データを絶対にコミットしない（CLAUDE.md ルール4） ---
# app.db / chat.db のコピーは本文を含む。
*.db
*.db-wal
*.db-shm
/fixtures/

# 自分プロファイル・相手プロファイルは個人の事実そのもの。
# 実体は ~/Library/Application Support/ 配下だが、
# 検証用にリポジトリへ置く事故を防ぐ。
self.md
/targets/
config.toml

# API キーは Keychain のみ。念のため。
.env
*.key

# Claude Code の個人設定。.claude/settings.json は共有するが、
# local は各自の許可リストなので入れない。
.claude/settings.local.json

_temp/
# 自動更新の署名鍵。**これが漏れると、偽の更新を配れる。**
# 既定の置き場所は ~/.tauri/ だが、リポジトリに置く事故を防ぐ。
*.key
*.key.pub
