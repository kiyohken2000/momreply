{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MomReply",
  "version": "0.1.0",
  "identifier": "net.votepurchase.momreply",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "MomReply",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczQ0QwMkU5RTJFNTE0QUUKUldTdUZPWGk2UUxOYysyTUVETG4vNXRzNzVsd1RxYVVLQUpmTXRldXp2SUl5U1dHZFJRcFQ4Z2cK",
      "endpoints": [
        "https://github.com/kiyohken2000/momreply/releases/latest/download/latest.json"
      ]
    }
  }
}
